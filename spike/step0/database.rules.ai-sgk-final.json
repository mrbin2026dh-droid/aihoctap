{
  "rules": {
    ".read": false,
    ".write": false,
    "catalog": {
      ".read": true,
      ".write": false
    },
    "packages": {
      ".read": true,
      ".write": false
    },
    "presence": {
      ".read": true,
      ".write": false,
      "$uid": {
        ".write": "$uid.length <= 64",
        ".validate": "!newData.exists() || (newData.hasChildren(['state', 'at']) && newData.child('state').isString() && newData.child('state').val().length <= 20 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "lop": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "state": {
          ".validate": "newData.val().matches(/^(hoc|phong_cho|dang_thi|da_nop|offline)$/)"
        },
        "at": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "thi_hs": {
      ".read": true,
      ".write": false
    },
    "thi_lop": {
      ".read": true,
      ".write": false
    },
    "thi_bai": {
      ".read": true,
      ".write": false
    },
    "thi_de": {
      ".read": true,
      ".write": false
    },
    "thi_vao": {
      ".read": true,
      "$ma_de": {
        "$ma": {
          ".write": "root.child('thi_bai').child($ma_de).exists() && $ma.length <= 64",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "thi_nop": {
      ".read": true,
      "$ma_de": {
        "$ma": {
          ".write": "newData.exists() && $ma.length <= 64 && ((root.child('thi_bai').child($ma_de).child('che_do').val() === 'that' && (root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'chua_thi' || root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'thi_lai') && newData.parent().parent().parent().child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'da_thi' && (root.child('thi_bai').child($ma_de).child('noi_dung').val() !== 'tn_th' || root.child('thi_th').child($ma_de).child($ma).exists())) || (!(root.child('thi_bai').child($ma_de).child('che_do').val() === 'that') && root.child('thi_bai').child($ma_de).child('trang_thai').val() === 'mo' && (!data.exists() || root.child('thi_bai').child($ma_de).child('che_do').val() === 'thu')))",
          ".validate": "newData.hasChildren(['ma','at']) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && (root.child('thi_bai').child($ma_de).child('che_do').val() === 'that' ? (!newData.hasChild('diem') && newData.hasChild('lan')) : (newData.hasChildren(['diem','tong']) && newData.child('diem').isNumber() && newData.child('tong').isNumber()))",
          "ma": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "ten": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "lop": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "dung": {
            ".validate": "newData.isNumber()"
          },
          "so_cau": {
            ".validate": "newData.isNumber()"
          },
          "diem": {
            ".validate": true
          },
          "tong": {
            ".validate": true
          },
          "at": {
            ".validate": true
          },
          "tra_loi": {
            "$q": {
              ".validate": "newData.isString() && newData.val().length <= 4"
            }
          },
          "tu_luan": {
            "$q": {
              ".validate": "$q.length <= 64 && newData.hasChildren(['tl', 'd', 'max']) && newData.child('tl').isString() && newData.child('tl').val().length <= 3000 && newData.child('d').isNumber() && newData.child('max').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() <= newData.child('max').val() && newData.child('max').val() <= 100",
              "tl": {
                ".validate": true
              },
              "d": {
                ".validate": true
              },
              "max": {
                ".validate": true
              },
              "nx": {
                ".validate": "newData.isString() && newData.val().length <= 600"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "diem_tn": {
            ".validate": "newData.isNumber()"
          },
          "cho_cham": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "lan": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
          },
          "cao_nhat": {
            ".validate": "newData.isNumber()"
          },
          "dau": {
            ".validate": "newData.isNumber()"
          },
          "roi_tab": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "chu_de": {
            "$t": {
              ".validate": "$t.length <= 64 && newData.hasChildren(['ten','d','n']) && newData.child('ten').isString() && newData.child('ten').val().length <= 60 && newData.child('d').isNumber() && newData.child('n').isNumber()"
            }
          },
          "thu_tu": {
            "q": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              }
            },
            "o": {
              "$q": {
                ".validate": "$q.length <= 64 && newData.isString() && newData.val().length <= 8"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "thi_th": {
      ".read": true,
      ".write": false
    },
    "thi_gv": {
      ".read": true,
      ".write": false
    },
    "quiz_key": {
      ".read": false,
      "$room": {
        ".write": "!data.exists() && $room.length === 6 && $room.matches(/^[0-9]+$/) && newData.isString() && newData.val().length >= 20 && newData.val().length <= 64"
      }
    },
    "quiz_proof": {
      ".read": false,
      "$room": {
        ".write": "newData.isString() && newData.val().length <= 140 && newData.val() !== data.val() && newData.val().beginsWith(root.child('quiz_key').child($room).val() + '|')"
      }
    },
    "quiz": {
      ".read": true,
      "$room": {
        "pub": {
          ".write": "root.child('quiz_key').child($room).exists() && newData.parent().parent().parent().child('quiz_proof').child($room).val() !== root.child('quiz_proof').child($room).val() && newData.parent().parent().parent().child('quiz_proof').child($room).val().beginsWith(root.child('quiz_key').child($room).val() + '|')"
        },
        "kq": {
          ".write": "root.child('quiz_key').child($room).exists() && newData.parent().parent().parent().child('quiz_proof').child($room).val() !== root.child('quiz_proof').child($room).val() && newData.parent().parent().parent().child('quiz_proof').child($room).val().beginsWith(root.child('quiz_key').child($room).val() + '|')"
        },
        "ds": {
          "$ma": {
            ".write": "!data.exists() && $ma.length <= 64 && root.child('quiz').child($room).child('pub').exists()",
            ".validate": "newData.hasChildren(['ten','at']) && newData.child('ten').isString() && newData.child('ten').val().length <= 100 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000"
          }
        },
        "ans": {
          "$q": {
            "$ma": {
              ".write": "!data.exists() && $ma.length <= 64 && root.child('quiz').child($room).child('pub').child('phase').val() === 'q' && root.child('quiz').child($room).child('pub').child('q').child('k').val() === $q && now <= root.child('quiz').child($room).child('pub').child('q').child('at').val() + root.child('quiz').child($room).child('pub').child('q').child('lim').val() * 1000 + 3000",
              ".validate": "newData.hasChildren(['a','t']) && newData.child('a').isString() && newData.child('a').val().matches(/^[A-D]$/) && newData.child('t').isNumber() && newData.child('t').val() <= now + 2000"
            }
          }
        },
        "$other": {
          ".write": false
        }
      }
    },
    "quiz_lop": {
      ".read": true,
      "$lop": {
        ".write": "$lop.length <= 40 && (newData.exists() ? newData.isString() : true) && root.child('quiz_key').child((newData.exists() ? newData.val() : data.val())).exists() && newData.parent().parent().child('quiz_proof').child((newData.exists() ? newData.val() : data.val())).val() !== root.child('quiz_proof').child((newData.exists() ? newData.val() : data.val())).val() && newData.parent().parent().child('quiz_proof').child((newData.exists() ? newData.val() : data.val())).val().beginsWith(root.child('quiz_key').child((newData.exists() ? newData.val() : data.val())).val() + '|')"
      }
    },
    "nang_luc": {
      ".read": true,
      "$ma": {
        ".write": "$ma.length <= 64",
        ".validate": "newData.hasChildren(['at','topics']) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000",
        "at": {
          ".validate": true
        },
        "ten": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "lop": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "topics": {
          "$t": {
            ".validate": "$t.length <= 64 && newData.hasChildren(['ten','d','n']) && newData.child('ten').isString() && newData.child('ten').val().length <= 60 && newData.child('d').isNumber() && newData.child('n').isNumber() && newData.child('n').val() <= 10000"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "doc_read": {
      ".read": true,
      "$bai": {
        "$ma": {
          ".write": "$bai.length <= 120 && $ma.length <= 64",
          ".validate": "newData.hasChildren(['pct','at']) && newData.child('pct').isNumber() && newData.child('pct').val() >= 0 && newData.child('pct').val() <= 100 && (!data.exists() || newData.child('pct').val() >= data.child('pct').val()) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000",
          "pct": {
            ".validate": true
          },
          "at": {
            ".validate": true
          },
          "ten": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "lop": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "tai_lieu": {
      ".read": true,
      ".write": false
    },
    "ho_tro": {
      ".read": true,
      ".write": false
    },
    "thoi_gian": {
      ".read": true,
      "$day": {
        ".validate": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
        "$uid": {
          ".write": "$uid.length <= 64",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440 && (!data.exists() ? newData.val() <= 2 : newData.val() <= data.val() + 2)"
        }
      }
    },
    "quiz_bo": {
      ".read": false,
      "$owner": {
        ".read": "$owner.length === 64 && $owner.matches(/^[0-9a-f]+$/)",
        ".write": "$owner.length === 64 && $owner.matches(/^[0-9a-f]+$/)",
        "$id": {
          ".validate": "$id.length <= 40 && (!newData.exists() || (newData.hasChildren(['name','qs','at']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('at').isNumber()))"
        }
      }
    },
    "tl_key": {
      ".read": false,
      "$room": {
        ".write": "!data.exists() && $room.length === 6 && $room.matches(/^[0-9]+$/) && newData.isString() && newData.val().length >= 20 && newData.val().length <= 64"
      }
    },
    "tl_proof": {
      ".read": false,
      "$room": {
        ".write": "newData.isString() && newData.val().length <= 140 && newData.val() !== data.val() && newData.val().beginsWith(root.child('tl_key').child($room).val() + '|')"
      }
    },
    "tl": {
      ".read": true,
      "$room": {
        "pub": {
          ".write": "root.child('tl_key').child($room).exists() && newData.parent().parent().parent().child('tl_proof').child($room).val() !== root.child('tl_proof').child($room).val() && newData.parent().parent().parent().child('tl_proof').child($room).val().beginsWith(root.child('tl_key').child($room).val() + '|')"
        },
        "ds": {
          "$ma": {
            ".write": "!data.exists() && $ma.length <= 64 && root.child('tl').child($room).child('pub').exists()",
            ".validate": "newData.hasChildren(['ten','at']) && newData.child('ten').isString() && newData.child('ten').val().length <= 100 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000"
          }
        },
        "y": {
          "$k": {
            "$ma": {
              "$n": {
                ".write": "!data.exists() && $ma.length <= 64 && root.child('tl').child($room).child('pub').child('phase').val() === 'open' && root.child('tl').child($room).child('pub').child('slide').child('k').val() === $k && root.child('tl').child($room).child('ds').child($ma).exists() && ($n === '0' || ($n === '1' && root.child('tl').child($room).child('pub').child('slide').child('max').val() >= 2) || ($n === '2' && root.child('tl').child($room).child('pub').child('slide').child('max').val() >= 3))",
                ".validate": "newData.hasChildren(['v','t']) && newData.child('v').isString() && newData.child('v').val().length >= 1 && newData.child('v').val().length <= 200 && (root.child('tl').child($room).child('pub').child('slide').child('type').val() !== 'cloud' || newData.child('v').val().length <= 25) && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000"
              }
            }
          }
        },
        "vote": {
          "$k": {
            "$q": {
              "$ma": {
                ".write": "$ma.length <= 64 && $q.length <= 80 && root.child('tl').child($room).child('pub').child('phase').val() === 'open' && root.child('tl').child($room).child('pub').child('slide').child('k').val() === $k && root.child('tl').child($room).child('ds').child($ma).exists()",
                ".validate": "newData.val() === true"
              }
            }
          }
        },
        "$other": {
          ".write": false
        }
      }
    },
    "tl_lop": {
      ".read": true,
      "$lop": {
        ".write": "$lop.length <= 40 && (newData.exists() ? newData.isString() : true) && root.child('tl_key').child((newData.exists() ? newData.val() : data.val())).exists() && newData.parent().parent().child('tl_proof').child((newData.exists() ? newData.val() : data.val())).val() !== root.child('tl_proof').child((newData.exists() ? newData.val() : data.val())).val() && newData.parent().parent().child('tl_proof').child((newData.exists() ? newData.val() : data.val())).val().beginsWith(root.child('tl_key').child((newData.exists() ? newData.val() : data.val())).val() + '|')"
      }
    },
    "tl_bo": {
      ".read": false,
      "$owner": {
        ".read": "$owner.length === 64 && $owner.matches(/^[0-9a-f]+$/)",
        ".write": "$owner.length === 64 && $owner.matches(/^[0-9a-f]+$/)",
        "$id": {
          ".validate": "$id.length <= 40 && (!newData.exists() || (newData.hasChildren(['name','at']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('at').isNumber()))"
        }
      }
    },
    "thi_tt": {
      ".read": true,
      "$ma_de": {
        "$ma": {
          "tt": {
            ".write": "data.exists() && (data.val() === 'chua_thi' || data.val() === 'thi_lai') && newData.val() === 'da_thi' && newData.parent().parent().parent().parent().child('thi_nop').child($ma_de).child($ma).exists()"
          },
          "nop_luc": {
            ".write": "(root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'chua_thi' || root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'thi_lai') && newData.parent().child('tt').val() === 'da_thi'",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "lan": {
            ".write": "(root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'chua_thi' || root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'thi_lai') && newData.parent().child('tt').val() === 'da_thi'",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
          }
        }
      }
    },
    "thi_tien_do": {
      ".read": true,
      "$ma_de": {
        "$ma": {
          ".write": "(root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'chua_thi' || root.child('thi_tt').child($ma_de).child($ma).child('tt').val() === 'thi_lai') && $ma.length <= 64",
          ".validate": "newData.hasChildren(['n','tong','at']) && newData.child('n').isNumber() && newData.child('tong').isNumber() && newData.child('n').val() >= 0 && newData.child('n').val() <= newData.child('tong').val() && newData.child('tong').val() <= 200 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000",
          "n": {
            ".validate": true
          },
          "tong": {
            ".validate": true
          },
          "at": {
            ".validate": true
          },
          "th": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "thi_goi_y": {
      ".read": false,
      ".write": false
    },
    "thi_drive": {
      ".read": true,
      ".write": false
    },
    "thi_cfg": {
      ".read": true,
      ".write": false
    },
    "thi_ip": {
      ".read": true,
      ".write": false
    }
  }
}
