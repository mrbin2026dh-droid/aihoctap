{
  "rules": {
    ".read": false,
    ".write": false,
    "system": {
      ".read": false,
      ".write": false
    },
    "students_auth": {
      ".read": false,
      ".write": false
    },
    "students": {
      "$classCode": {
        ".read": "auth != null && auth.token.admin === true",
        "$studentId": {
          ".read": "auth != null && (auth.uid === $studentId || auth.token.admin === true)",
          ".write": "auth != null && (auth.token.admin === true || (auth.uid === $studentId && (!data.child('is_blocked').exists() || data.child('is_blocked').val() === false) && (!data.child('is_blocked').exists() ? !newData.child('is_blocked').exists() : newData.child('is_blocked').val() === data.child('is_blocked').val()) && (!data.child('exams').exists() ? !newData.child('exams').exists() : newData.child('exams').val() === data.child('exams').val())))",
          ".indexOn": [
            "is_blocked",
            "email",
            "student_code"
          ],
          "presence": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $studentId"
          }
        }
      }
    },
    "exam_answers": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "exam_submissions": {
      "$examId": {
        "$studentId": {
          ".read": "auth != null && (auth.uid === $studentId || auth.token.admin === true)",
          ".write": "auth != null && (auth.token.admin === true || (auth.uid === $studentId && !newData.hasChildren(['score']) && !newData.hasChildren(['evaluation'])))",
          ".indexOn": [
            "student_id",
            "class_code",
            "score"
          ]
        }
      }
    },
    "documents": {
      ".read": "auth != null",
      "$docId": {
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "documents_meta": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "courses": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "packages": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "packages_private": {
      ".read": false,
      ".write": "auth != null && auth.token.admin === true"
    },
    "exam_defs": {
      ".read": false,
      ".write": false
    },
    "exam_secrets": {
      ".read": false,
      ".write": false
    },
    "exams": {
      ".read": false,
      ".write": false
    },
    "exams_private": {
      ".read": false,
      ".write": false
    },
    "exam_sessions": {
      ".read": false,
      ".write": false
    },
    "attempt_details": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "attempts": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true",
        "$attemptId": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
          ".write": "auth != null && auth.token.admin === true"
        }
      }
    },
    "spike": {
      "sessions": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('started_at').val() === now"
        }
      },
      "drafts": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n'])"
        }
      },
      "attempts": {
        "$uid": {
          "$n": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && ($n === '1' || $n === '2') && root.child('spike/sessions/' + $uid + '/started_at').exists() && now <= root.child('spike/sessions/' + $uid + '/started_at').val() + 2730000"
          }
        }
      },
      "results": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "secret": {
        ".read": false,
        ".write": false
      },
      "reports": {
        "$uid": {
          "$k": {
            ".read": false,
            ".write": "auth != null && auth.uid === $uid && !data.exists()"
          }
        }
      }
    }
  }
}