# Bộ não AI — chép thành .env (chmod 600). KHÔNG đưa tệp .env lên Git hay gửi qua chat.
# Firebase Realtime Database của ứng dụng (đọc dữ liệu học tập)
FB_URL=https://ai-sgk-tinhoc-default-rtdb.asia-southeast1.firebasedatabase.app
FB_SECRET=dán-Database-secret-ở-đây
# Worker (lấy nhật ký câu hỏi Gia sư). BRAIN_KEY = khóa đặt bằng: npx wrangler secret put BRAIN_KEY
WORKER_URL=https://ten-worker-cua-ban.workers.dev
BRAIN_KEY=
# Google Sheet (địa chỉ /exec) + khóa tạo ở menu Bài thi → Cài khóa Bộ não AI
SHEET_URL=https://script.google.com/macros/s/.../exec
SHEET_BRAIN_KEY=
# Gemini để viết báo cáo (để trống → báo cáo dạng mẫu, không dùng AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cơ sở dữ liệu lịch sử trên VPS
DB_PATH=/var/lib/brain/brain.sqlite3
TZ_OFFSET_HOURS=7
