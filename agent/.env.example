# Sao chép thành /opt/agent/.env (quyền 600). KHÔNG đưa tệp .env lên GitHub.
# Khóa bảo vệ: Worker gửi kèm tiêu đề X-Agent-Key. Tạo: openssl rand -hex 32 (đặt cùng giá trị cho Worker: wrangler secret put AGENT_KEY)
AGENT_KEY=
# Một hoặc nhiều khóa Gemini (Google AI Studio), cách nhau dấu phẩy. Khóa lỗi / hết lượt thì tự đổi khóa khác.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
# Mô hình dự phòng (để trống nếu không có). Dùng tên mô hình có thật trong AI Studio.
GEMINI_FALLBACK_MODEL=
# (Tùy chọn) nhà cung cấp dự phòng có API tương thích OpenAI
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Số lần chấm để bỏ phiếu (1–5). 3 = chính xác hơn, tốn lượt gấp 3.
AGENT_VOTES=3
AGENT_CONCURRENCY=4
AGENT_DB=/var/lib/brain/agent.sqlite3
AGENT_PORT=8787
