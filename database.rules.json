{
  "rules": {
    ".read": true,
    ".write": true,
    "students": {
      "$classCode": {
        ".read": true,
        ".write": true,
        ".indexOn": ["is_blocked", "email", "student_code"]
      }
    },
    "exams": {
      ".read": true,
      ".write": true,
      ".indexOn": ["grade", "status"]
    },
    "exam_submissions": {
      "$examId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["student_id", "class_code", "score"]
      }
    }
  }
}
